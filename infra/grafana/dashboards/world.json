{
  "uid": "campus-world",
  "title": "Campus world",
  "description": "world's sockets, connect success and the work behind them.",
  "tags": ["campus", "world"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "metrics",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "hide": 0,
        "current": {}
      },
      {
        "name": "traces",
        "label": "Traces",
        "type": "datasource",
        "query": "tempo",
        "regex": "/-traces$/",
        "hide": 0,
        "current": {}
      },
      {
        "name": "logs",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "regex": "/-logs$/",
        "hide": 0,
        "current": {}
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Campus dashboards",
      "type": "dashboards",
      "tags": ["campus"],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Connections",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Open sockets",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum(world_connections{job=\"world\"}) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 2,
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Connect success",
      "description": "opened ÷ (opened + failed + abandoned); refusals are left out. The SLO is 99%. Until issue #118 is fixed, a refused tab that closes during world's first read of the spaces after a boot counts as abandoned, so this can read a little low just after a deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum(increase(world_connections_opened_total{job=\"world\"}[$__range])) / (sum(increase(world_connections_opened_total{job=\"world\"}[$__range])) + (sum(increase(world_connections_failed_total{job=\"world\"}[$__range])) or vector(0)) + (sum(increase(world_connections_abandoned_total{job=\"world\"}[$__range])) or vector(0)))",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 3,
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Failed upgrades",
      "description": "Upgrades world could not finish: its own fault, not the client's.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum(increase(world_connections_failed_total{job=\"world\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 4,
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "stat",
      "title": "Largest unsent buffer",
      "description": "The most any one socket has waiting to send. world cuts off a socket that stops reading.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "max(world_socket_buffered_bytes{job=\"world\"})",
          "legendFormat": "__auto",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "id": 5,
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Open sockets by cohort",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum by (cohort_id) (world_connections{job=\"world\"})",
          "legendFormat": "{{cohort_id}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 6,
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Connect success, rolling hour",
      "description": "opened ÷ (opened + failed + abandoned); refusals are left out. The SLO is 99%. Until issue #118 is fixed, a refused tab that closes during world's first read of the spaces after a boot counts as abandoned, so this can read a little low just after a deploy.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum(increase(world_connections_opened_total{job=\"world\"}[1h])) / (sum(increase(world_connections_opened_total{job=\"world\"}[1h])) + (sum(increase(world_connections_failed_total{job=\"world\"}[1h])) or vector(0)) + (sum(increase(world_connections_abandoned_total{job=\"world\"}[1h])) or vector(0)))",
          "legendFormat": "connect success",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Upgrades by outcome",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum(rate(world_connections_opened_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "opened",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "B",
          "expr": "sum(rate(world_connections_refused_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "refused",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "C",
          "expr": "sum(rate(world_connections_failed_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "failed",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "D",
          "expr": "sum(rate(world_connections_abandoned_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "abandoned",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 8,
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Refusals by reason",
      "description": "A refusal is the client's to fix: signed out, a wrong origin, not a member.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum by (reason) (rate(world_connections_refused_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "{{reason}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0,
          "noValue": "None in this period"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 9,
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Closes by code",
      "description": "Every close, by WebSocket code. 1006 is a connection that dropped without closing.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum by (code) (rate(world_connections_closed_total{job=\"world\"}[$__rate_interval])) * 60",
          "legendFormat": "{{code}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "opm",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
