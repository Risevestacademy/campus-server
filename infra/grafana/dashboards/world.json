            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 10,
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Sockets world closed, by reason",
      "description": "Each deploy closes every socket with server shutting down, so that reason spikes at each release.",
      "datasource": {
        "type": "prometheus",
        "uid": "${metrics}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${metrics}"
          },
          "refId": "A",
          "expr": "sum by (reason) (rate(world_connections_closed_by_server_total{job=\"world\"}[$__rate_interval])) * 60",
