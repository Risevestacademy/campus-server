      "datasource": {
        "type": "tempo",
        "uid": "${traces}"
      },
      "targets": [
        {
          "datasource": {
            "type": "tempo",
            "uid": "${traces}"
          },
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name = \"campus-api\" && kind = server && duration > 500ms } | rate()",
          "metricsQueryType": "range",
          "limit": 20,
          "tableType": "traces"
        }
