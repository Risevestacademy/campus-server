      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${logs}"
          },
          "refId": "A",
          "expr": "sum by (severity_text) (count_over_time({service_name=\"campus-api\"} | severity_text=~\"warn|error|fatal\" [$__auto]))",
          "queryType": "range",
          "legendFormat": "{{severity_text}}"
