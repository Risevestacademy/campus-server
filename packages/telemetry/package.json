{
  "name": "@campus/telemetry",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./paths": {
      "types": "./dist/paths.d.ts",
      "default": "./dist/paths.js"
    },
    "./sql": {
      "types": "./dist/sql.d.ts",
      "default": "./dist/sql.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint src/",
    "test": "vitest run"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/instrumentation": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-runtime-node": "^0.35.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "^2.11.0",
    "@opentelemetry/sdk-trace": "^2.11.0",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
