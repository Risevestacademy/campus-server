# World ---------------------------------------------------------------------
# Realtime service: sockets, presence and positions. It reads the session
# tokens campus-api signs, so the secret below must be the same value.

PORT=3001
DEPLOYMENT_ENVIRONMENT=development

# Browser origins allowed to open a socket. A WebSocket upgrade is exempt from
# CORS, so unset means no browser can connect — which is the safe default.
CORS_ORIGINS=http://localhost:3000

# Must match campus-api's AUTH_SESSION_SECRET.
AUTH_SESSION_SECRET=

# A socket that misses two heartbeats in a row is dropped.
WORLD_HEARTBEAT_SECONDS=30
# Largest frame accepted from a client, in bytes.
WORLD_MAX_MESSAGE_BYTES=16384

# Logging -------------------------------------------------------------------
FF_LOG_LEVEL=info
FF_LOG_PRETTY=false

# Database ------------------------------------------------------------------
# Read-only: world checks that the account behind a token still exists and is
# not suspended, so a ban reaches open sockets instead of waiting out the
# token. Same database campus-api writes.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus
WORLD_DB_POOL=5
