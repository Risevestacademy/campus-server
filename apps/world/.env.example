# World ---------------------------------------------------------------------
# Realtime service: sockets, presence and positions. It reads the session
# tokens campus-api signs, so the secret below must be the same value.

PORT=3001
DEPLOYMENT_ENVIRONMENT=development

# Browser origins allowed to open a socket — the web app's origin. A WebSocket
# upgrade is exempt from CORS, so unset means no browser can connect, which is
# the safe default.
CORS_ORIGINS=http://localhost:3002

# Must match campus-api's AUTH_SESSION_SECRET.
AUTH_SESSION_SECRET=

# A socket that misses two heartbeats in a row is dropped.
WORLD_HEARTBEAT_SECONDS=30
# Largest frame accepted from a client, in bytes.
WORLD_MAX_MESSAGE_BYTES=16384
# Frames one socket may send per second. A second's worth may arrive at once;
# the first frame past that closes the socket before it is parsed.
WORLD_MAX_MESSAGES_PER_SECOND=20
# Bytes waiting unsent to one socket before its client counts as not reading
# and is disconnected.
WORLD_MAX_BUFFERED_BYTES=1048576

# Placeholder map, in tiles, until real maps load. Spawn must be inside it.
WORLD_MAP_WIDTH=40
WORLD_MAP_HEIGHT=30
WORLD_SPAWN_X=20
WORLD_SPAWN_Y=15
# Fastest walk: one tile per this many milliseconds.
WORLD_STEP_MS=100
# How often everybody is told who moved, in milliseconds.
WORLD_TICK_MS=50
# Reconnect within this many seconds and you are back where you stood. 0 = off.
WORLD_RECONNECT_GRACE_SECONDS=30

# Where each player last stood, kept between visits. Unset keeps nothing, and
# everybody starts at the spawn. Local: the redis container in
# docker-compose.local.yml.
REDIS_URL=redis://localhost:6379
# How often positions of people who moved are written; a crash loses at most this.
WORLD_POSITION_SAVE_SECONDS=60
# A saved position lapses after this many days without a visit.
WORLD_POSITION_TTL_DAYS=90
# Who is online, kept in the same Redis so more than one instance can run.
# An entry lapses this many seconds after its instance stops renewing it, so a
# crashed instance's people drop out on their own. Unset REDIS_URL keeps
# presence in memory, which is only right for a single instance.
WORLD_PRESENCE_TTL_SECONDS=60
# A socket stays open while its sign-in was refreshed within this many seconds.
# At least 1020: the shared session policy's longest access token (15 minutes)
# plus two minutes of slack. world refuses to boot below that.
WORLD_SESSION_REFRESH_WINDOW_SECONDS=1200

# Media (LiveKit)
# The media server and the key pair that signs room tokens. All three, or none:
# unset, audio and video are off and POST /media/connection-check answers 503.
# Local: the container in docker-compose.local.yml and the dev key in
# livekit.yaml. Hosted: the LiveKit Cloud project for this environment.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=local-dev-secret-not-for-production-use
# Connection-check tokens one account may be given per minute.
WORLD_CONNECTION_CHECKS_PER_MINUTE=5

# Logging -------------------------------------------------------------------
FF_LOG_LEVEL=info
FF_LOG_PRETTY=false

# Database ------------------------------------------------------------------
# Read-only: world checks that the account behind a token still exists and is
# not suspended, so a ban reaches open sockets instead of waiting out the
# token. Same database campus-api writes.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus
WORLD_DB_POOL=5
