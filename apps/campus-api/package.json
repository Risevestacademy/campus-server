  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "db:generate": "drizzle-kit generate --config src/infra/database/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config src/infra/database/drizzle.config.ts",
    "db:push": "drizzle-kit push --config src/infra/database/drizzle.config.ts",
    "db:seed": "node dist/infra/database/seed.js",
    "db:studio": "drizzle-kit studio --config src/infra/database/drizzle.config.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@campus/session": "workspace:*",
    "@campus/analytics": "workspace:*",
