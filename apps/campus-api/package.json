    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/mapped-types": "^12.0.0",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@opentelemetry/instrumentation-express": "^0.70.0",
    "@scalar/nestjs-api-reference": "^1.2.17",
    "campus-world-map": "^0.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^11.1.0",
    "nestjs-pino": "^5.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "catalog:",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.31.0",
