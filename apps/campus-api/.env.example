# Environment configuration for campus-api
# Copy this file to .env and adjust values as needed.
# All values below match the defaults validated in src/infra/config/env.ts.

# Application ---------------------------------------------------------------
# Node runtime mode. The app itself never branches on this; it only informs
# the Node/Nest ecosystem. Feature behavior is controlled by explicit FF_ flags
# below (FF_LOG_LEVEL, FF_LOG_PRETTY, FF_OTEL_ENABLED, ...).
NODE_ENV=development
PORT=3000

# Database ----------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus

# Seeding -------------------------------------------------------------------
# The admins to create or promote: one address, or several separated by
# commas (e.g. ada@campus.local,grace@campus.local). Only the Google address
# is needed; name and avatar come from Google at first sign-in. Read only by
# `pnpm db:seed`, never by the running API; seeding fails if it is unset.
DEFAULT_ADMIN_EMAIL=admin@campus.local

# Invites -------------------------------------------------------------------
# The web app's origin. Builds the shareable invite link
# ({base}/invitation?token=<raw>), and is where sign-in redirects: /, /invitation
# or /sign-in?error=<code>. Required: boot fails without it.
APP_PUBLIC_URL=http://localhost:3000
# Days until a new invite expires when the request omits expiresAt.
INVITE_TTL_DAYS=7

# Google sign-in
FF_GOOGLE_AUTH_ENABLED=false
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback
# AUTH_STATE_SECRET=
# AUTH_SESSION_SECRET=
# Access token, refresh token, and how long someone has to finish onboarding.
AUTH_SESSION_TTL_MINUTES=15
AUTH_REFRESH_TTL_DAYS=30
AUTH_PROVISIONAL_TTL_MINUTES=30
# Parent domain to share the access cookie under, so world on a subdomain
# receives it (e.g. campus.example for world.campus.example). Must cover
# APP_PUBLIC_URL and GOOGLE_CALLBACK_URL. Unset = host-only, right for local.
# AUTH_COOKIE_DOMAIN=

# HTTP ----------------------------------------------------------------------
# Browser origins allowed to call the API, comma-separated — the web app's
# origin, as in APP_PUBLIC_URL. Unset = no CORS headers at all, so browser
# apps are blocked. See docs/deployment.md, "Domains and cookies".
CORS_ORIGINS=http://localhost:3000
# Reverse proxies in front of the app. Railway is 1; 0 trusts none.
TRUST_PROXY_HOPS=0

# Logging -------------------------------------------------------------------
# Minimum pino level to emit: trace | debug | info | warn | error | fatal
FF_LOG_LEVEL=info
# Pretty human-readable output (pino-pretty). Set to false for JSON lines.
FF_LOG_PRETTY=true

# OpenTelemetry ------------------------------------------------------------
# Environment label attached to traces as deployment.environment.
DEPLOYMENT_ENVIRONMENT=development
# Master switch; when "false" telemetry is fully skipped (no traces, no
# trace_id/span_id in logs).
FF_OTEL_ENABLED=true
# Node.js runtime metrics (memory, CPU, event loop); "false" keeps metrics off
# while traces still flow.
FF_OTEL_METRICS_ENABLED=true
OTEL_SERVICE_NAME=campus-api

# The OTel SDK reads the exporter settings below directly from the process
# environment (they are NOT part of the validated Env class). See the
# Telemetry section of README.md for details.
#
# Local OpenTelemetry Collector (docker-compose.local.yml):
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   (unset - defaults to http://localhost:4318, so no need to set for local)
#
# New Relic example:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.nr-data.net:4318
#   OTEL_EXPORTER_OTLP_HEADERS=api-key=YOUR_NR_LICENSE_KEY
#
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_EXPORTER_OTLP_HEADERS=

# Email (Resend) -------------------------------------------------------------
# Emails each new invite's link to the invitee. Off by default, so local
# development never sends mail; invites still work, and the admin shares the
# link by hand. When true, both values below are required or startup fails.
FF_EMAIL_ENABLED=false
# API key from Resend (starts with re_). One per environment.
# RESEND_API_KEY=
# Sender: an address or "Name <address>".
# EMAIL_FROM=Campus by Rise <invites@campusbyrise.com>

# PostHog --------------------------------------------------------------------
# Product analytics + error tracking. Master switch; when true, POSTHOG_PROJECT_TOKEN
# must also be set or startup fails.
FF_POSTHOG_ENABLED=false
# Project API key from PostHog (Project Settings > Project API Key). Use the
# key for the project matching this environment (e.g. campus-staging vs
# campus-production) so frontend and backend events land in the same project.
# POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://eu.i.posthog.com